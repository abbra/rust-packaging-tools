#!/usr/bin/python3
"""rust-deps — run the rust_deps package straight from this checkout.

The tool lives in the rust_deps/ package next to this file; this launcher only
puts that directory on sys.path and calls into it, so the command works from
any checkout or from an installed copy of the skill without installing
anything.  See rust_deps/__init__.py for the tool description.
"""

import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

from rust_deps.cli import main

if __name__ == "__main__":
    main()
